# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=your-supabase-url-here
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Supabase Admin (management API) credentials — used only by dev scripts like
# mileage-verify.cjs for test-user cleanup. NEVER commit the real values.
# Personal access token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your-personal-access-token-here
# Project ref: the `abcxyz` part of https://<ref>.supabase.co
SUPABASE_PROJECT_REF=your-project-ref-here

# =============================================================================
# Email delivery
# =============================================================================

# --- Brevo (transactional) ---
# 1) SUPABASE AUTH SMTP — configure manually in the dashboard OR via the
#    Management API (see below). These feed the local `supabase` CLI via
#    config.toml; for the cloud project, enter the same values at
#    https://supabase.com/dashboard/project/_/auth/smtp
#    host: smtp-relay.brevo.com · port 587 (STARTTLS) or 465 (SSL)
#    user = your Brevo SMTP login email · pass = your Brevo SMTP key (Settings → SMTP)
#    (the SMTP key is NOT the API key).
BREVO_SMTP_USER=your-brevo-smtp-login@example.com
BREVO_SMTP_PASS=your-brevo-smtp-key
BREVO_SMTP_FROM=no-reply@your-sending-domain.com

# 2) EDGE FUNCTION secrets (set in the remote project, not in this file):
#    npx supabase secrets set BREVO_API_KEY=xkeysib-... \
#      BREVO_SENDER_EMAIL=no-reply@your-sending-domain.com BREVO_SENDER_NAME=PaySmooth
#    BREVO_API_KEY = Brevo API key (Settings → API keys) — used by the
#    send-transactional-email edge function for non-auth transactional emails.

# Alternative: configure cloud Auth SMTP programmatically with the Management API
# (uncomment and run once):
#   curl -X PATCH "https://api.supabase.com/v1/projects/$SUPABASE_PROJECT_REF/config/auth" \
#     -H "Authorization: Bearer $SUPABASE_ACCESS_TOKEN" -H "Content-Type: application/json" \
#     -d '{"external_email_enabled":true,"mailer_autoconfirm":false,
#          "smtp_admin_email":"'"$BREVO_SMTP_FROM"'","smtp_host":"smtp-relay.brevo.com",
#          "smtp_port":587,"smtp_user":"'"$BREVO_SMTP_USER"'","smtp_pass":"'"$BREVO_SMTP_PASS"'",
#          "smtp_sender_name":"PaySmooth"}'

# --- Sender.net (marketing / newsletter) ---
# On user signup the app calls the sync-marketing-contact edge function, which
# adds the new user's email to your Sender list. Set these remote secrets:
#    npx supabase secrets set \
#      SENDER_API_KEY=your-sender-access-token \
#      SENDER_GROUP_ID=your-list-group-id
# SENDER_API_KEY — Sender access token (app.sender.net → Settings → API access tokens)
# SENDER_GROUP_ID — optional; the group/newsletter list id to add subscribers to.
