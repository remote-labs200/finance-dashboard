# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=your-supabase-url-here
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# AI Edge Function URL (Optional — for AI categorization, receipt OCR, and insights)
# Deploy the Edge Functions from supabase/functions/ and set the URL here.
# Example: https://<project-ref>.supabase.co/functions/v1
# Without this, AI features fall back to rule-based logic.
EXPO_PUBLIC_AI_EDGE_FUNCTION_URL=https://<project-ref>.supabase.co/functions/v1
